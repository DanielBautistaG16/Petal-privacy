Sub Process_Globals
	Dim GPS1 As GPS
	Private audioStreamer As AudioStreamer 'Para capturar y procesar audio

End Sub

Sub Globals
	Dim lblLon As Label
	Dim lblLat As Label
	Dim lblSpeed As Label
	Dim lblSatellites As Label
	
	Dim btnConnect As Button
	Dim progressBar1,progressBar2 As ProgressBar
	Dim lblStatus As Label
	Dim lblMessage As Label
	Private rp As RuntimePermissions
	Private B4XImageView2 As B4XImageView
	Private b4xSwitch1 As B4XSwitch
	
	Private recButton As Button
	Private stopButton As Button
	Private filterLabel As Label
	
End Sub

Sub Activity_Create(FirstTime As Boolean)
	If FirstTime Then
		GPS1.Initialize("GPS")
		Log("GPS")
	End If
	
	
	Activity.LoadLayout("1")
	Activity.LoadLayout("2")
    
	' Inicializamos el AudioStreamer para que use el micrófono
	audioStreamer.Initialize("audioStreamer", 44100, True, 16, 1)
    
	' Aquí puedes aplicar alguna técnica simple de preprocesamiento del audio
	' Por ejemplo, puedes aplicar una reducción básica de ruido simulada o preprocesar el audio
    
	recButton.Initialize("recButton")
	stopButton.Initialize("stopButton")
	filterLabel.Initialize("filterLabel")
	
	recButton.Text = "Grabar"
	stopButton.Text = "Detener"
	filterLabel.Text = "Preparado para grabar audio"
End Sub

Sub Activity_Resume
	If GPS1.GPSEnabled = False Then
		ToastMessageShow("Please enable the GPS device.", True)
		StartActivity(GPS1.LocationSettingsIntent) 'Will open the relevant settings screen.
	Else
		GPS1.Start(0, 0) 'Listen to GPS with no filters.
		
	End If
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	GPS1.Stop
End Sub

Sub GPS_LocationChanged (Location1 As Location)
	lblLat.Text = "Lat = " & Location1.ConvertToMinutes(Location1.Latitude)
	lblLon.Text = "Lon = " & Location1.ConvertToMinutes(Location1.Longitude)
'	lblSpeed.Text = "Speed = " & Location1.Speed
'	lblSpeed.Text = NumberFormat(1.60934*60/25* Location1.Speed,2,0)&" Km/h"
	lblSpeed.Text = NumberFormat(1.60934*60/25* Location1.Speed,2,0)
End Sub

Sub GPS_UserEnabled (Enabled As Boolean)
	ToastMessageShow("GPS device enabled = " & Enabled, True)
End Sub

Sub GPS_GnssStatus (Satellites As List)
	lblSatellites.Text = "Satellites:" & CRLF
	For i = 0 To Satellites.Size - 1
		Dim Satellite As GPSSatellite
		Satellite = Satellites.Get(i)
		lblSatellites.Text = lblSatellites.Text & CRLF & Satellite.Prn & _
			" " & Satellite.Snr & " " & Satellite.UsedInFix & " " & Satellite.Azimuth _ 
			& " " & Satellite.Elevation
	Next
End Sub







Private Sub SwiftMap_Click
	Dim p As PhoneIntents
	StartActivity(p.OpenBrowser("https://www.google.com/maps/@?api=1&map_action=map&hl=es-419"))
End Sub

Private Sub lblMap_Click
	Dim p As PhoneIntents
	StartActivity(p.OpenBrowser("https://www.google.com/maps/@?api=1&map_action=map&hl=es-419"))
End Sub

'..........................................................
Public Sub SetState
	'Switch1.Enabled = Starter.connect
	btnConnect.Enabled = Not(Starter.connected)
	progressBar1.Visible = Starter.connecting
	Dim status As String
	If Starter.connected Then
		status = "connected"
		
		'Switch1.Checked=True
	else if Starter.connecting Then
		status = "connecting"
		lblStatus.Color=232
	Else
		status = "disconnected"
		'Switch1.Checked=False
		lblStatus.Color=325
	End If
	lblStatus.Text = $" ${status}"$
	
End Sub

Public Sub SetDesconectar
	progressBar1.Visible = Starter.connected
End Sub

Public Sub MessageFromDevice(msg As String)
	Dim NivelBat= Round2(msg/5*100,0) As Int
	
	lblMessage.Text="BATTERY LEVEL "&CRLF&NivelBat &" %"
	Log(lblMessage.Text)
	Log(msg)
	
	
End Sub




