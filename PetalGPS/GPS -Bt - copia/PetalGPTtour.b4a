Sub btnConnect_Click
	rp.CheckAndRequest(rp.PERMISSION_ACCESS_COARSE_LOCATION)
	Log("Esperando")
	Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
	If Result Then
		CallSub(Starter, "Connect")
	'	progressBar2.Progress=4
	Else
		ToastMessageShow("No permission", True)
	End If
End Sub


Private Sub B4XSwitch1_ValueChanged (Value As Boolean)
	If Value=True Then 
		rp.CheckAndRequest(rp.PERMISSION_ACCESS_COARSE_LOCATION)
		Log("Esperando")
		Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
		If Result Then
			CallSub(Starter, "Connect")
		Else
			ToastMessageShow("No permission", True)
		End If
	Else
		Starter.connected=False
		Log("desconectado")
		SetDesconectar
		CallSub(Starter, "disConnect")
	End If	
		
End Sub



' Grabar audio al pulsar el botón de grabar
Sub recButton_Click
    audioStreamer.StartRecording ' Inicia la grabación de audio
    filterLabel.Text = "Grabando..."
End Sub

' Detener la grabación al pulsar el botón de detener
Sub stopButton_Click
    audioStreamer.StopRecording ' Detiene la grabación
    filterLabel.Text = "Grabación detenida"
End Sub

' Manejo de los eventos del AudioStreamer (si es necesario)
Sub audioStreamer_RecordBuffer (Buffer() As Byte)
    ' Aquí es donde puedes procesar manualmente el audio grabado (Buffer)
    ' Aplicar procesamiento simple como filtros manuales o efectos.
    
    ' Por ejemplo, podrías aplicar un filtrado básico de ruido:
    ' Aquí se podría implementar una rutina de procesamiento de audio en tiempo real
    ' Si tienes una librería externa para reducción de ruido o ecualización, podrías aplicarlo aquí
End Sub


