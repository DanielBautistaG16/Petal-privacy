<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0F7FF"/>
            <stroke android:width="1.5dp" android:color="@color/petal_blue_pressed"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke android:width="1.5dp" android:color="@color/surface_disabled"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke android:width="1.5dp" android:color="@color/petal_blue"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
