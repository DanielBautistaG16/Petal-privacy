<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/petal_blue_pressed"/>
            <stroke android:width="4dp" android:color="@color/petal_blue"/>
            <size android:width="220dp" android:height="220dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/petal_blue"/>
            <stroke android:width="4dp" android:color="@color/petal_blue_pressed"/>
            <size android:width="220dp" android:height="220dp"/>
        </shape>
    </item>
</selector>
